# Discord Developer Portal -> Bot token and General Information -> Application ID
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id

# Supabase (recommended: persistent tickets, ratings and transcripts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared support assistant: connect the Discord bot to the website's verified AI knowledge.
# Set this to your production Champ Client site URL (no trailing slash).
SUPPORT_API_URL=https://your-live-site.example
SITE_URL=https://your-live-site.example
