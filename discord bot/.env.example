# Discord Developer Portal -> Bot -> Token, and General Information -> Application ID
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-application-client-id

# Register commands instantly in one server (recommended while developing).
# Leave empty to register them globally (Discord can take up to an hour to show them).
GUILD_ID=your-server-id

# Optional: persistent ticket rows in Supabase (run supabase/schema.sql first).
# Without these the bot stores tickets, giveaways and welcome overrides under data/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: point the JSON stores at a Railway volume so restarts keep the data.
# DATA_DIR=/data

# Shared support assistant: connect the bot to the website's verified AI knowledge.
SUPPORT_API_URL=https://champ-site-psi.vercel.app
SITE_URL=https://champ-site-psi.vercel.app

# Privileged intents to enable in the Discord Developer Portal -> Bot:
#   SERVER MEMBERS INTENT  (welcome, auto roles, goodbye)
#   MESSAGE CONTENT INTENT (ticket activity and the AI support mention)
