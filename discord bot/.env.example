# ---------------------------------------------------------------------------
# Champ Discord bot — copy to .env (local) or add these in Railway → Variables.
# Never commit the real .env: .gitignore already excludes it.
# ---------------------------------------------------------------------------

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
# Optional. With a guild id commands appear instantly; without it they register globally.
GUILD_ID=

# Public links used by /help, /status, the welcome message and the support replies.
SITE_URL=https://champ-site-psi.vercel.app
DISCORD_INVITE=https://discord.gg/6vyQnVjeX
# Runtime
# Railway injects PORT. Locally you can set it to test http://localhost:PORT/health.
PORT=
# error | warn | info | debug
LOG_LEVEL=info
# Channel that receives bot errors (and only errors, throttled per message).
ERROR_LOG_CHANNEL_ID=
# Channel that receives every /mod action and every /rules · /announce post.
MOD_LOG_CHANNEL_ID=
# Register the slash commands on every start (recommended; set to false to manage them by hand).
AUTO_DEPLOY_COMMANDS=true
# Data folder for tickets, giveaways, welcome overrides and transcripts.
# On Railway attach a volume and use /data.
DATA_DIR=./data

# Optional: shared ticket history with the website. Apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
