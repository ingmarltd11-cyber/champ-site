# Minecraft Microsoft account for the bot. It must own Java Edition.
MC_EMAIL=bot@example.com
MC_AUTH=microsoft
MC_HOST=donutsmp.net
MC_PORT=25565
MC_VERSION=1.21.4
# Put this on a Railway volume so the Microsoft login survives restarts.
MC_PROFILES_DIR=/data/minecraft-auth

# Shared secret: exactly the same value as DONUT_BOT_TOKEN on the Vercel site.
DONUT_BOT_TOKEN=change-this-to-a-long-random-string
CHAMP_API_URL=https://champ-site-psi.vercel.app

# Optional. Default is 15000 ms. Railway sets PORT for the health endpoint.
POLL_MS=15000
# Optional: only needed when DonutSMP changes its payment wording.
# DONUT_PAY_REGEX=^(?<sender>[A-Za-z0-9_]{3,16}) paid you \$?(?<amount>[\d,]+)
