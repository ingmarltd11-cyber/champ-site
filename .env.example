# Copy these into Vercel: Project -> Settings -> Environment Variables
# (never commit a real .env file)

# Your live site, no trailing slash. Used in e-mail links and Stripe redirects.
SITE_URL=https://your-domain.com

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=            # the SECRET / service_role key (never the public one)
DOWNLOAD_BUCKET=downloads

# Random 32+ characters, e.g. run: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: separate secret for hardware challenges and per-license watermarks.
# Leave empty to derive it from JWT_SECRET. Set it once and keep it stable.
LICENSE_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_ID=price_...
STRIPE_PRICE_LIFETIME_ID=price_...

# Email verification (signup). Off by default: accounts work immediately and no mail is
# sent, which is what you want without a domain. Set to true after configuring Resend/SMTP.
EMAIL_VERIFICATION=false

# Resend (e-mail) — requires a verified domain for arbitrary recipients
RESEND_API_KEY=re_...
FROM_EMAIL=Champ Client <noreply@your-domain.com>

# No-domain fallback: Gmail SMTP (requires 2-Step Verification + App Password)
# or any SMTP relay. Leave RESEND_API_KEY empty to use this path.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=Champ Client <your@gmail.com>

# AI support assistant (Groq). Optional: without a key the assistant still answers the
# common support questions from its built-in knowledge, so the chat keeps working.
# A key adds free-form answers for everything else. Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: force a provider when both keys are set.
# AI_PROVIDER=groq

# Only for local testing; leave unset in production
# DEV_MODE=true

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Discord linking + Champ+ rank (Discord Developer Portal -> your application)
# Redirect URI to add in the portal: https://your-domain.com/api/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token + server + Champ+ role for automatic rank assignment:
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
CHAMP_PLUS_ROLE_ID=
